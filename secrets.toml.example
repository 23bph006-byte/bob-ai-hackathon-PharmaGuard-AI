# PharmaGuard AI — Streamlit secrets template
# ──────────────────────────────────────────────────────────────────────────────
# COPY this file to .streamlit/secrets.toml and fill in your real values.
# NEVER commit secrets.toml to version control.
# This .example file contains only placeholders — it is safe to commit.
# ──────────────────────────────────────────────────────────────────────────────

# IBM watsonx.ai credentials
# Obtain from: IBM Cloud → Manage → Access (IAM) → API keys
WATSONX_API_KEY = "YOUR_IBM_CLOUD_API_KEY_HERE"

# Your watsonx.ai project ID
# Obtain from: watsonx.ai → Manage → General → Project ID
WATSONX_PROJECT_ID = "YOUR_WATSONX_PROJECT_ID_HERE"

# Regional endpoint — Frankfurt (eu-de) is the default for PharmaGuard AI
# Other options: https://us-south.ml.cloud.ibm.com  (Dallas)
#                https://eu-gb.ml.cloud.ibm.com      (London)
#                https://jp-tok.ml.cloud.ibm.com     (Tokyo)
WATSONX_URL = "https://eu-de.ml.cloud.ibm.com"

# IBM Granite model to use.
# Verified available in Frankfurt (eu-de) region:
#   ibm/granite-3-8b-instruct        (recommended — 8B, fast)
#   ibm/granite-3-2b-instruct        (smaller, faster)
#   ibm/granite-13b-instruct-v2      (larger, more detailed)
WATSONX_MODEL_ID = "ibm/granite-3-8b-instruct"
